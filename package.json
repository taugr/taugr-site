{
  "name": "taugr",
  "version": "0.0.1",
  "private": true,
  "description": "Personal website for Tom Auger, built with Astro and published as a static site.",
  "keywords": [
    "astro",
    "blog",
    "personal-website",
    "portfolio",
    "static-site"
  ],
  "homepage": "https://github.com/tom-auger/agentic-aspirations#readme",
  "bugs": {
    "url": "https://github.com/tom-auger/agentic-aspirations/issues"
  },
  "license": "UNLICENSED",
  "author": "Tom Auger <tom@tau.gr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom-auger/agentic-aspirations.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
