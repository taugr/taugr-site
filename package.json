{
  "name": "taugr",
  "version": "0.0.1",
  "private": true,
  "description": "Personal website for Tom Auger, built with Astro and published as a static site.",
  "keywords": [
    "astro",
    "blog",
    "personal-website",
    "portfolio",
    "static-site"
  ],
  "homepage": "https://github.com/tom-auger/agentic-aspirations#readme",
  "bugs": {
    "url": "https://github.com/tom-auger/agentic-aspirations/issues"
  },
  "license": "UNLICENSED",
  "author": "Tom Auger <tom@tau.gr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom-auger/agentic-aspirations.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:webmcp": "node --experimental-strip-types --test scripts/webmcp.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
