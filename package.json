{
  "name": "taugr",
  "version": "0.0.1",
  "private": true,
  "description": "Personal website for Tom Auger, built with Astro and published as a static site.",
  "keywords": [
    "astro",
    "blog",
    "personal-website",
    "portfolio",
    "static-site"
  ],
  "homepage": "https://github.com/tom-auger/agentic-aspirations#readme",
  "bugs": {
    "url": "https://github.com/tom-auger/agentic-aspirations/issues"
  },
  "license": "UNLICENSED",
  "author": "Tom Auger <tom@tau.gr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom-auger/agentic-aspirations.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:webmcp": "node --experimental-strip-types --test scripts/webmcp.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
