---
import BaseLayout from './BaseLayout.astro';
import { getImage, Image } from 'astro:assets';
import { LOCALES, type Locale } from '../i18n';
import { SITE } from '../site';

const { frontmatter, alternatePaths, locale = 'en' as Locale } = Astro.props;
const socialImage = frontmatter.image
  ? await getImage({
      src: frontmatter.image,
      width: 1200,
      height: 630,
      fit: 'cover',
      position: 'centre',
      format: 'jpg',
      quality: 85,
    })
  : undefined;

function formatDate(date: Date | string): string {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString(LOCALES[locale as Locale].tag, { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

const tagColors = [
  { bg: 'var(--color-tag-purple-bg)', text: 'var(--color-tag-purple-text)', border: 'var(--color-tag-purple-border)' },
  { bg: 'var(--color-tag-blue-bg)', text: 'var(--color-tag-blue-text)', border: 'var(--color-tag-blue-border)' },
  { bg: 'var(--color-tag-green-bg)', text: 'var(--color-tag-green-text)', border: 'var(--color-tag-green-border)' },
  { bg: 'var(--color-tag-amber-bg)', text: 'var(--color-tag-amber-text)', border: 'var(--color-tag-amber-border)' },
  { bg: 'var(--color-tag-rose-bg)', text: 'var(--color-tag-rose-text)', border: 'var(--color-tag-rose-border)' },
];

function hashTag(tag: string): number {
  let hash = 0;
  for (let i = 0; i < tag.length; i++) {
    hash = ((hash << 5) - hash) + tag.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash) % tagColors.length;
}

function getTagColor(tag: string) {
  return tagColors[hashTag(tag)];
}
---

<BaseLayout
  title={`${frontmatter.title} — ${SITE.name}`}
  description={frontmatter.description}
  socialTitle={frontmatter.title}
  ogImage={socialImage?.src}
  ogImageAlt={socialImage ? frontmatter.imageAlt ?? frontmatter.title : undefined}
  ogImageType={socialImage ? 'image/jpeg' : undefined}
  ogType="article"
  locale={locale}
  alternatePaths={alternatePaths}
  publishedTime={frontmatter.date}
  tags={frontmatter.tags}
>
  <article class:list={{ 'editorial': frontmatter.editorial }}>
    <div class="flex items-center gap-2 mb-2 text-[0.82rem] text-(--color-text-tertiary)">
      {formatDate(frontmatter.date)} · {frontmatter.readingTime || '5 min read'}
    </div>
    {frontmatter.tags?.length > 0 && (
      <div class="flex gap-1.5 mb-3">
        {frontmatter.tags.map((tag: string) => {
          const color = getTagColor(tag);
          return (
            <span
              class="text-[0.7rem] px-2 py-0.5 rounded border font-medium"
              style={`background: ${color.bg}; color: ${color.text}; border-color: ${color.border};`}
            >
              {tag}
            </span>
          );
        })}
      </div>
    )}
    <h1 class="text-[1.6rem] font-bold leading-tight tracking-tight text-(--color-text)">
      {frontmatter.title}
    </h1>
    {frontmatter.editorial && <p class="article-deck">{frontmatter.description}</p>}
    {frontmatter.image && (
      <Image
        src={frontmatter.image}
        alt={frontmatter.imageAlt ?? ''}
        widths={[390, 780, 1200, 1536]}
        sizes="(max-width: 820px) calc(100vw - 40px), 780px"
        format="webp"
        quality={85}
        class="article-cover"
        loading="eager"
        decoding="async"
      />
    )}
    <div class="mt-6 prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .site-main > article.editorial > h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .article-deck {
    margin-top: 1.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .editorial .prose { margin-top: 2rem; }
  .article-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    object-position: center;
    margin-top: 1.75rem;
    border-radius: 3px;
  }
  .editorial .prose a { overflow-wrap: anywhere; }
  .prose p {
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 1.3rem;
    line-height: 1.85;
  }
  .prose strong { font-weight: 600; }
  .prose .article-endnote {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .prose .article-endnote p {
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-style: normal;
    line-height: 1.75;
  }
  .prose a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover { text-decoration-thickness: 2px; }
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose ul, .prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.3rem;
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.85;
  }
  .prose li { margin-bottom: 0.3rem; }
  .prose blockquote {
    border-left: 3px solid var(--color-border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .prose .pull-quote {
    position: relative;
    margin: 2.75rem 0;
    padding: 1.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    break-inside: avoid;
  }
  .prose .pull-quote::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 3rem;
    height: 3px;
    background: var(--color-accent);
  }
  .prose .pull-quote p {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.55rem, 4vw, 2rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .prose .pull-quote a {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-style: normal;
    white-space: nowrap;
    vertical-align: super;
  }
  .prose img {
    border-radius: 0.375rem;
    margin: 1.5rem 0;
  }
  .prose code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-code-bg);
    border: 1px solid var(--color-code-border);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }
</style>
