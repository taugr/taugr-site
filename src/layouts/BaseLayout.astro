---
import type { EssayAlternates } from '../data/essays';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import PostHog from '../components/posthog.astro';
import {
  exactRouteKey,
  getMessages,
  LOCALES,
  localeFromPath,
  localizedPath,
  ROUTES,
  type Locale,
  type RouteKey,
} from '../i18n';
import { PROFILE_LINKS, SITE } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  socialTitle?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  tags?: string[];
  wide?: boolean;
  locale?: Locale;
  alternatePaths?: EssayAlternates;
}

const {
  title,
  socialTitle = title,
  description = SITE.description,
  ogImage = '/social-card.png',
  ogImageAlt,
  ogImageType,
  ogType = 'website',
  publishedTime,
  tags = [],
  wide = false,
  locale: requestedLocale,
  alternatePaths,
} = Astro.props;
const locale = requestedLocale ?? localeFromPath(Astro.url.pathname);
const messages = getMessages(locale);
const translatedRoute = exactRouteKey(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage, Astro.site);
const socialImageAlt = ogImageAlt ?? messages.site.description;
const socialImageType = ogImageType ?? (ogImage === '/social-card.png' ? 'image/png' : undefined);
const publishedDate = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const developmentPreview = import.meta.env.DEV;
const previewHome = localizedPath(locale, 'home');
if (developmentPreview) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const navItems = (Object.keys(ROUTES) as RouteKey[])
  .filter(route => route !== 'archive' && route !== 'home')
  .flatMap(route => {
    const item = { route, href: localizedPath(locale, route), label: messages.nav[route] };
    return route === 'projects'
      ? [item, { route: 'research', href: '/research/', label: 'research' }]
      : [item];
  });
const alternateLinks = alternatePaths
  ? (Object.entries(alternatePaths) as [Locale, string][]).map(([locale, path]) => ({ locale, href: new URL(path, Astro.site) }))
  : translatedRoute
  ? (Object.keys(LOCALES) as Locale[]).map(alternateLocale => ({
      locale: alternateLocale,
      href: new URL(localizedPath(alternateLocale, translatedRoute), Astro.site),
    }))
  : [];
---

<!doctype html>
<html lang={LOCALES[locale].tag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {developmentPreview && <meta name="robots" content="noindex, nofollow" />}
    {developmentPreview && <style is:inline>astro-dev-toolbar { display: none; }</style>}
    <style is:inline>
      .curated-menu-toggle { display: none; }
      @media (max-width: 760px) {
        .site-header--curated .site-header__inner { grid-template-columns: minmax(0, 1fr) auto; gap: 0 0.5rem; min-height: 0; padding: 1rem 0; }
        .site-header--curated .site-brand { grid-column: 1; grid-row: 1; display: flex; align-items: center; min-height: 44px; }
        .site-header--curated[data-menu-ready="true"] .curated-menu-toggle { grid-column: 2; grid-row: 1; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0 0.25rem; border: 0; background: transparent; color: var(--color-nav-muted); font: 450 0.82rem var(--font-sans); cursor: pointer; }
        .site-header--curated .site-nav { grid-column: 1 / -1; grid-row: 2; flex-direction: column; align-items: stretch; gap: 0; padding: 0.75rem 0 0.5rem; }
        .site-header--curated .site-nav__link { display: flex; align-items: center; min-height: 44px; padding: 0.25rem 0; }
        .site-header--curated .site-actions { grid-column: 1 / -1; grid-row: 3; justify-self: start; gap: 0.5rem; padding-top: 0.5rem; }
        .site-header--curated[data-menu-ready="true"] .site-nav, .site-header--curated[data-menu-ready="true"] .site-actions { display: none; }
        .site-header--curated[data-menu-open="true"] .site-nav, .site-header--curated[data-menu-open="true"] .site-actions { display: flex; }
        .site-header--curated .site-brand:focus-visible, .site-header--curated .curated-menu-toggle:focus-visible, .site-header--curated .site-nav__link:focus-visible, .site-header--curated .theme-toggle:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; border-radius: 3px; }
        .site-header--curated .curated-menu-toggle:hover, .site-header--curated .curated-menu-toggle[aria-expanded="true"] { color: var(--color-link); }
        .site-header--curated .language-picker summary, .site-header--curated .language-picker a { min-height: 44px; }
        .site-header--curated .language-picker ul { left: 0; right: auto; }
        .site-header--curated .theme-toggle { min-width: 44px; min-height: 44px; justify-content: center; margin-left: 0; padding: 0; }
      }
    </style>
    <link rel="canonical" href={canonicalURL} />
    {alternateLinks.map(link => <link rel="alternate" hreflang={LOCALES[link.locale].tag} href={link.href} />)}
    {alternateLinks.some(link => link.locale === 'en') && <link rel="alternate" hreflang="x-default" href={alternateLinks.find(link => link.locale === 'en')?.href} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={SITE.links.rss} />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Noto+Sans+Armenian:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="author" content={messages.site.footerName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={messages.site.name} />
    <meta property="og:locale" content={LOCALES[locale].og} />
    {alternateLinks.filter(link => link.locale !== locale).map(link => <meta property="og:locale:alternate" content={LOCALES[link.locale].og} />)}
    <meta property="og:image" content={socialImageURL} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {ogType === 'article' && <meta property="article:author" content={new URL(localizedPath(locale, 'about'), Astro.site)} />}
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tomaugr" />
    <meta name="twitter:creator" content="@tomaugr" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{title}</title>
    <script is:inline>
      // Prevent flash of wrong theme
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
    <PostHog />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header site-header--curated">
        <div class="site-header__inner">
          <a href={previewHome} class="site-brand" data-site-brand>
            {messages.site.name}
          </a>
          <button type="button" class="curated-menu-toggle" id="curated-menu-toggle" aria-expanded="false" aria-controls="curated-navigation curated-menu-actions">menu</button>
          <nav id="curated-navigation" class="site-nav" aria-label={messages.site.primaryNavigation}>
          {navItems.map(item => (
            <a
              href={item.href}
              data-nav-route={item.route}
              aria-current={(Astro.url.pathname === item.href || Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}
              class:list={[
                'site-nav__link',
                Astro.url.pathname === item.href || Astro.url.pathname.startsWith(item.href)
                  ? 'site-nav__link--active'
                  : '',
              ]}
            >
              {item.label}
            </a>
          ))}
          </nav>
          <div id="curated-menu-actions" class="site-actions">
            {PROFILE_LINKS.map(link => (
              <a
                href={link.href}
                class="site-actions__link"
                target="_blank"
                rel="me noopener"
                aria-label={link.label}
                data-profile-link={link.label}
              >
                <i
                  class:list={[
                    'ph',
                    link.label === 'github' && 'ph-github-logo',
                    link.label === 'linkedin' && 'ph-linkedin-logo',
                    link.label === 'x' && 'ph-x-logo',
                  ]}
                  aria-hidden="true"
                ></i>
              </a>
            ))}
            <LanguagePicker locale={locale} pathname={Astro.url.pathname} alternatePaths={alternatePaths} />
            <ThemeToggle locale={locale} />
          </div>
        </div>
      </header>
      <script is:inline>
        (function () {
          var header = document.querySelector('.site-header--curated');
          var button = document.getElementById('curated-menu-toggle');
          var nav = document.getElementById('curated-navigation');
          var actions = document.getElementById('curated-menu-actions');
          if (!header || !button || !nav || !actions) return;
          var mobile = window.matchMedia('(max-width: 760px)');
          var lastFocused = null;
          document.addEventListener('focusin', function (event) {
            lastFocused = header.contains(event.target) ? event.target : null;
          });
          function setOpen(open, restoreFocus) {
            header.dataset.menuOpen = String(open);
            button.setAttribute('aria-expanded', String(open));
            if (!open) {
              header.querySelector('.language-picker[open]')?.removeAttribute('open');
              if (restoreFocus) button.focus();
            }
          }
          header.dataset.menuReady = 'true';
          setOpen(false);
          button.addEventListener('click', function () {
            setOpen(button.getAttribute('aria-expanded') !== 'true');
          });
          nav.addEventListener('click', function (event) {
            if (mobile.matches && event.target.closest('a')) setOpen(false);
          });
          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && mobile.matches && button.getAttribute('aria-expanded') === 'true') {
              event.preventDefault();
              setOpen(false, true);
            }
          });
          mobile.addEventListener('change', function () {
            var focus = document.activeElement;
            if (focus === document.body) focus = lastFocused;
            setOpen(false);
            if (!mobile.matches && focus === button) nav.querySelector('a')?.focus();
            if (mobile.matches && (nav.contains(focus) || actions.contains(focus))) button.focus();
          });
        })();
      </script>

      <main class:list={['site-main', wide ? 'site-main--wide' : 'site-main--reading']}>
        <slot />
      </main>

      <footer class="site-footer">
        <span data-footer-owner>&copy; {new Date().getFullYear()} {messages.site.footerName}</span>
        <span class="site-footer__links">
          <a href="mailto:tom@tau.gr">{locale === 'hy' ? 'էլ․ փոստ' : locale === 'es' ? 'correo' : 'email'}</a>
          {PROFILE_LINKS.map(link => (
            <>
              <a href={link.href} target="_blank" rel="me noopener" data-profile-link={link.label}>{link.label}</a>
            </>
          ))}
          <a href={localizedPath(locale, 'archive')} data-footer-archive>{messages.site.archive}</a>
          <a href={SITE.links.rss} id="rss-link">{messages.site.rss}</a>
        </span>
      </footer>
    </div>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-profile-link]').forEach(function (el) {
          el.addEventListener('click', function () {
            window.posthog?.capture('profile_link_clicked', {
              link_label: el.getAttribute('data-profile-link'),
              link_href: el.getAttribute('href'),
            });
          });
        });

        var rssLink = document.getElementById('rss-link');
        rssLink?.addEventListener('click', function () {
          window.posthog?.capture('rss_feed_clicked');
        });
      });
    </script>
    <script>
      import { installWebMCP } from '../webmcp/register';

      installWebMCP(document, window, window.fetch.bind(window));
    </script>
  </body>
</html>

<style is:global>
</style>
