---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MESSAGES } from '../i18n';
---

<BaseLayout title="Not Found — taugr">
  <script is:inline>
    const path = window.location.pathname;
    const redirects = new Map([
      ['/about', '/about/'],
      ['/search', '/archive/'],
      ['/fringeevents.html', '/archive/'],
    ]);

    const postRedirects = new Map([
      ['/posts/2021-06-08-simple-vs-easy/', '/archive/posts/2021-06-08-simple-vs-easy/'],
      ['/posts/2019/2019-06-27-secret-box/', '/archive/posts/2019-06-27-secret-box/'],
      ['/posts/2019-03-02-set-up-wireguard-vpn-ubuntu-mac/', '/essays/set-up-wireguard-vpn-ubuntu-mac/'],
      ['/posts/2019-03-03-set-up-cloudflared-ubuntu-wireguard/', '/essays/set-up-cloudflared-ubuntu-wireguard/'],
      ['/posts/2020/2020-02-23-my_customizations_i3/', '/archive/posts/2020-02-23-my_customizations_i3/'],
      ['/posts/2021-06-08-zsh-command-time/', '/archive/posts/2021-06-08-zsh-command-time/'],
      ['/posts/2018-06-20-two-chrome-dev-console-tricks/', '/archive/posts/2018-06-20-two-chrome-dev-console-tricks/'],
    ]);

    const normalized = path.endsWith('/') ? path : `${path}/`;
    let destination = redirects.get(path) || postRedirects.get(normalized);

    if (!destination && normalized.startsWith('/posts/page/')) {
      destination = '/archive/';
    }

    if (!destination && normalized.startsWith('/posts/')) {
      destination = `/archive/posts/${normalized.replace(/^\/posts\//, '')}`;
    }

    if (
      !destination &&
      (
        normalized.startsWith('/archives/') ||
        normalized.startsWith('/tags/') ||
        normalized.startsWith('/categories/') ||
        normalized.startsWith('/series/') ||
        normalized.startsWith('/page/')
      )
    ) {
      destination = '/archive/';
    }

    if (!destination && normalized.startsWith('/tumo2023/')) {
      destination = '/teaching/tumo2023/';
    }

    if (!destination && normalized.startsWith('/aitalk/')) {
      destination = '/speaking/aitalk/';
    }

    if (!destination && normalized.startsWith('/aisymposium/')) {
      destination = '/speaking/aisymposium/';
    }

    if (destination) {
      window.location.replace(destination);
    }
  </script>
  <div class="text-center py-16">
    <h1 class="text-[2rem] font-bold text-(--color-text) mb-2">404</h1>
    <p id="not-found-message" class="text-(--color-text-secondary) mb-6">This page doesn't exist.</p>
    <a id="not-found-home" href="/" class="text-(--color-link) text-[0.85rem] hover:underline">Back to home</a>
  </div>
  <script is:inline define:vars={{ translations: {
    es: MESSAGES.es,
    hy: MESSAGES.hy,
  } }}>
    function localizeNotFound() {
      const locale = window.location.pathname.match(/^\/(es|hy)(?:\/|$)/)?.[1];
      if (!locale || !translations[locale]) return;
      const copy = translations[locale];
      const homeHref = `/${locale}/`;
      document.documentElement.lang = locale === 'es' ? 'es-ES' : 'hy-AM';
      document.title = copy.notFound.title;
      const message = document.getElementById('not-found-message');
      const home = document.getElementById('not-found-home');
      if (message) message.textContent = copy.notFound.message;
      if (home) {
        home.textContent = copy.notFound.home;
        home.setAttribute('href', homeHref);
      }

      const brand = document.querySelector('[data-site-brand]');
      if (brand) {
        brand.textContent = copy.site.name;
        brand.setAttribute('href', homeHref);
      }
      const nav = document.querySelector('.site-nav');
      nav?.setAttribute('aria-label', copy.site.primaryNavigation);
      document.querySelectorAll('[data-nav-route]').forEach(function (link) {
        const route = link.getAttribute('data-nav-route');
        if (!route) return;
        link.textContent = copy.nav[route];
        link.setAttribute('href', route === 'home' ? homeHref : `/${locale}/${route}/`);
      });
      const footerOwner = document.querySelector('[data-footer-owner]');
      if (footerOwner) footerOwner.textContent = `© ${new Date().getFullYear()} ${copy.site.footerName}`;
      const footerArchive = document.querySelector('[data-footer-archive]');
      if (footerArchive) {
        footerArchive.textContent = copy.site.archive;
        footerArchive.setAttribute('href', `/${locale}/archive/`);
      }
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.setAttribute('aria-label', copy.theme.toggle);
        themeToggle.dataset.lightLabel = copy.theme.light;
        themeToggle.dataset.darkLabel = copy.theme.dark;
        const themeLabel = document.getElementById('theme-label');
        const dark = document.documentElement.classList.contains('dark');
        if (themeLabel) themeLabel.textContent = dark ? copy.theme.light : copy.theme.dark;
      }
      const languageSummary = document.querySelector('.language-picker summary');
      languageSummary?.setAttribute('aria-label', copy.site.chooseLanguage);
      languageSummary?.setAttribute('title', copy.site.chooseLanguage);
      const currentLanguage = document.querySelector('[data-language-current]');
      const shortLanguage = document.querySelector('[data-language-short]');
      if (currentLanguage) currentLanguage.textContent = locale === 'es' ? 'Español' : 'Հայերեն';
      if (shortLanguage) shortLanguage.textContent = locale === 'es' ? 'ES' : 'ՀՅ';
      document.querySelectorAll('[data-language-choice]').forEach(function (link) {
        const choice = link.getAttribute('data-language-choice');
        if (!choice) return;
        link.setAttribute('href', choice === 'en' ? '/' : `/${choice}/`);
        if (choice === locale) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', localizeNotFound, { once: true });
    } else {
      localizeNotFound();
    }
  </script>
</BaseLayout>
