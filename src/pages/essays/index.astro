---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getMessages } from '../../i18n';

const messages = getMessages('en');
const posts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={messages.essays.title} description={messages.essays.description}>
  <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">{messages.essays.heading}</h1>
  <p class="text-[0.95rem] text-(--color-text-secondary) mb-6 sm:mb-8">{messages.essays.description}</p>
  <PostList posts={sorted} />
</BaseLayout>
