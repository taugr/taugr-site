---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import ContactInvite from '../../components/ContactInvite.astro';
import { teachingItems } from '../../data/teaching';
import { localizeTeaching } from '../../i18n';
---
<BaseLayout title="Teaching — taugr" description="Learning labs, workshops, and masterclasses by taugr.">
  <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">Teaching</h1>
  <p class="text-[0.95rem] text-(--color-text-secondary) mb-8">Learning labs, workshops, and masterclasses.</p>
  <ExperienceList items={localizeTeaching(teachingItems, 'en')} kind="teaching" locale="en" />
  <ContactInvite />
</BaseLayout>
