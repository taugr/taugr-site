---
import { getCollection } from 'astro:content';
import { compareProjects } from '../../data/project-order';
import AboutTimeline from '../../components/AboutTimeline.astro';
import ContactInvite from '../../components/ContactInvite.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import { essayLocale, getLocalizedPosts } from '../../data/essays';
import PostList from '../../components/PostList.astro';
import ProjectsList from '../../components/ProjectsList.astro';
import CuratedHomepage from '../../components/CuratedHomepage.astro';
import { speakingTalks } from '../../data/speaking';
import { teachingItems } from '../../data/teaching';
import {
  ABOUT_TIMELINE,
  formatDate,
  getMessages,
  localizeSpeaking,
  localizeTeaching,
  localizedPath,
  type Locale,
  type RouteKey,
} from '../../i18n';

type LocalizedLocale = Exclude<Locale, 'en'>;

export function getStaticPaths() {
  const locales: LocalizedLocale[] = ['es', 'hy'];
  const pages: { page: string | undefined; route: RouteKey }[] = [
    { page: undefined, route: 'home' },
    { page: 'essays', route: 'essays' },
    { page: 'projects', route: 'projects' },
    { page: 'teaching', route: 'teaching' },
    { page: 'speaking', route: 'speaking' },
    { page: 'about', route: 'about' },
    { page: 'archive', route: 'archive' },
  ];

  return locales.flatMap(locale =>
    pages.map(({ page, route }) => ({
      params: { locale, page },
      props: { locale, route },
    })),
  );
}

const { locale, route } = Astro.props as { locale: LocalizedLocale; route: RouteKey };
const messages = getMessages(locale);
const projects = await getCollection('projects');
const sortedProjects = projects.sort(compareProjects);
const posts = await getLocalizedPosts(locale);
const archiveEntries = (await getCollection('archive', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const localizedTeaching = localizeTeaching(teachingItems, locale);
const localizedSpeaking = localizeSpeaking(speakingTalks, locale);
const pageMeta = {
  home: { title: messages.home.title, description: messages.site.description, wide: true },
  essays: { title: messages.essays.title, description: messages.essays.description, wide: false },
  projects: { title: messages.projects.title, description: messages.projects.description, wide: false },
  teaching: { title: messages.teaching.title, description: messages.teaching.description, wide: false },
  speaking: { title: messages.speaking.title, description: messages.speaking.description, wide: false },
  about: { title: messages.about.title, description: messages.about.description, wide: false },
  archive: { title: messages.archivePage.title, description: messages.archivePage.description, wide: false },
}[route];

---

<BaseLayout title={pageMeta.title} description={pageMeta.description} wide={pageMeta.wide} locale={locale}>
  {route === 'home' && <CuratedHomepage locale={locale} />}

  {route === 'projects' && (
    <>
      <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">{messages.projects.heading}</h1>
      <p class="text-[0.95rem] text-(--color-text-secondary) mb-8">{messages.projects.description}</p>
      <ProjectsList projects={sortedProjects} locale={locale} />
    </>
  )}

  {route === 'teaching' && (
    <>
      <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">{messages.teaching.heading}</h1>
      <p class="text-[0.95rem] text-(--color-text-secondary) mb-8">{messages.teaching.description}</p>
      <ExperienceList items={localizedTeaching} kind="teaching" locale={locale} />
      <ContactInvite locale={locale} />
    </>
  )}

  {route === 'speaking' && (
    <>
      <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">{messages.speaking.heading}</h1>
      <p class="text-[0.95rem] text-(--color-text-secondary) mb-8">{messages.speaking.description}</p>
      <ExperienceList items={localizedSpeaking} kind="speaking" locale={locale} />
      <ContactInvite kind="speaking" locale={locale} />
    </>
  )}

  {route === 'about' && (
    <>
      <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-4">{messages.about.heading}</h1>
      <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-start">
        <img src="/img/about/from-idea-to-prototype-profile.webp" alt={messages.home.name} class="h-24 w-24 shrink-0 rounded-full border border-(--color-border-light) bg-(--color-bg-secondary) object-cover object-[50%_18%] sm:h-28 sm:w-28" loading="eager" decoding="async" />
        <div class="text-[1rem] text-(--color-text) leading-relaxed space-y-4">
          <p>{messages.about.intro}</p>
          <p>{messages.about.interests}</p>
          <p>{messages.about.contactBefore} <a href="mailto:tom@tau.gr" class="text-(--color-link) underline underline-offset-2 hover:decoration-2">tom@tau.gr</a>.</p>
          <blockquote class="border-l-2 border-(--color-border) pl-4 text-[0.86rem] text-(--color-text-secondary) italic">{messages.about.understandingQuote}</blockquote>
          <blockquote class="border-l-2 border-(--color-border) pl-4 text-[0.86rem] text-(--color-text-secondary) italic">{messages.about.quote}</blockquote>
        </div>
      </div>
      <AboutTimeline items={ABOUT_TIMELINE[locale]} />
    </>
  )}

  {route === 'essays' && (
    <>
      <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">{messages.essays.heading}</h1>
      <p class="text-[0.95rem] text-(--color-text-secondary) mb-2">{messages.essays.description}</p>
      {posts.some(post => essayLocale(post) === 'en') && <p class="article-language-notice">{messages.essays.englishNotice}</p>}
      <PostList posts={posts} locale={locale} />
    </>
  )}

  {route === 'archive' && (
    <>
      <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">{messages.archivePage.heading}</h1>
      <p class="text-[0.95rem] text-(--color-text-secondary) mb-2">{messages.archivePage.description}</p>
      <p class="article-language-notice">{messages.archivePage.englishNotice}</p>
      {archiveEntries.map((entry, index) => (
        <article class:list={['mb-5 pb-5', index < archiveEntries.length - 1 && 'border-b border-(--color-border-light)']}>
          <a href={`/archive/${entry.id}/`} class="group block no-underline">
            <h2 class="text-[0.98rem] font-semibold text-(--color-text) leading-snug group-hover:text-(--color-link) transition-colors">{entry.data.title}</h2>
            <div class="mt-1 text-[0.82rem] text-(--color-text-tertiary)">{formatDate(entry.data.date, locale)} · {messages.archivePage.archivedFrom} · {messages.archivePage.english}</div>
            <p class="text-[0.9rem] text-(--color-text-secondary) mt-1.5 leading-relaxed">{entry.data.description}</p>
          </a>
        </article>
      ))}
    </>
  )}
</BaseLayout>
