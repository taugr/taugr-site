---
import { getCollection } from 'astro:content';
import { compareProjects } from '../../data/project-order';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsList from '../../components/ProjectsList.astro';

const allProjects = (await getCollection('projects'))
  .sort(compareProjects);
---

<BaseLayout title="Projects — taugr" description="A selection of my products, tools, and research.">
  <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">Projects</h1>
  <p class="text-[0.95rem] text-(--color-text-secondary) mb-8">A selection of my products, tools, and research.</p>
  <ProjectsList projects={allProjects} />
</BaseLayout>
