---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import ContactInvite from '../../components/ContactInvite.astro';
import { speakingTalks } from '../../data/speaking';
import { localizeSpeaking } from '../../i18n';
---
<BaseLayout title="Speaking — taugr" description="Public talks, panels, and appearances by taugr.">
  <h1 class="text-[1.6rem] font-bold text-(--color-text) tracking-tight mb-1">Speaking</h1>
  <p class="text-[0.95rem] text-(--color-text-secondary) mb-8">Recent talks and panels.</p>
  <ExperienceList items={localizeSpeaking(speakingTalks, 'en')} kind="speaking" locale="en" />
  <ContactInvite kind="speaking" />
</BaseLayout>
