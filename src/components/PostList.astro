---
import { Image } from 'astro:assets';
import { essayLocale, essayPath, readingTime, type Essay } from '../data/essays';
import { LOCALES } from '../i18n';
import { formatDate, getMessages, type Locale } from '../i18n';

interface Props {
  posts: Essay[];
  locale?: Locale;
}

const { posts, locale = 'en' } = Astro.props;
const messages = getMessages(locale);

// Tag color palette — each tag gets a consistent color via hash
const tagColors = [
  { bg: 'var(--color-tag-purple-bg)', text: 'var(--color-tag-purple-text)', border: 'var(--color-tag-purple-border)' },
  { bg: 'var(--color-tag-blue-bg)', text: 'var(--color-tag-blue-text)', border: 'var(--color-tag-blue-border)' },
  { bg: 'var(--color-tag-green-bg)', text: 'var(--color-tag-green-text)', border: 'var(--color-tag-green-border)' },
  { bg: 'var(--color-tag-amber-bg)', text: 'var(--color-tag-amber-text)', border: 'var(--color-tag-amber-border)' },
  { bg: 'var(--color-tag-rose-bg)', text: 'var(--color-tag-rose-text)', border: 'var(--color-tag-rose-border)' },
];

function hashTag(tag: string): number {
  let hash = 0;
  for (let i = 0; i < tag.length; i++) {
    hash = ((hash << 5) - hash) + tag.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash) % tagColors.length;
}

function getTagColor(tag: string) {
  return tagColors[hashTag(tag)];
}
---

{posts.map((post, i) => (
  <article class:list={['mb-6 pb-6', i < posts.length - 1 && 'border-b border-(--color-border-light)']}>
    <a href={essayPath(post)} class:list={['group no-underline', post.data.image ? 'post-list-entry--illustrated flex items-start gap-4' : 'block']}>
      <div class="post-list-content min-w-0 flex-1">
        <h3 lang={LOCALES[essayLocale(post)].tag} class="text-[1.08rem] font-semibold text-(--color-text) leading-snug group-hover:text-(--color-link) transition-colors">
          {post.data.title}
        </h3>
        <div class="flex flex-wrap items-center gap-2 mt-1 text-[0.82rem] text-(--color-text-tertiary)">
          {formatDate(post.data.date, locale)} · {readingTime(post.body ?? '', locale)}
          {locale !== 'en' && essayLocale(post) === 'en' && <span class="article-language">· {messages.essays.english}</span>}
        </div>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-1.5">
            {post.data.tags.slice(0, 3).map(tag => {
              const color = getTagColor(tag);
              return (
                <span
                  class="text-[0.7rem] px-2 py-0.5 rounded border font-medium"
                  style={`background: ${color.bg}; color: ${color.text}; border-color: ${color.border};`}
                >
                  {tag}
                </span>
              );
            })}
          </div>
        )}
        <p lang={LOCALES[essayLocale(post)].tag} class="text-[0.94rem] text-(--color-text-secondary) mt-1.5 leading-relaxed">
          {post.data.description}
        </p>
      </div>
      {post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          width={320}
          height={214}
          widths={[96, 160, 192, 320]}
          sizes="(min-width: 640px) 160px, 96px"
          format="webp"
          class="h-16 w-24 sm:h-auto sm:w-40 aspect-[3/2] shrink-0 rounded border border-(--color-border-light) object-cover"
          loading="lazy"
        />
      )}
    </a>
  </article>
))}

<style>
  @media (max-width: 639px) {
    .post-list-entry--illustrated {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 96px;
      gap: 0.5rem 1rem;
    }
    .post-list-entry--illustrated .post-list-content { display: contents; }
    .post-list-entry--illustrated .post-list-content > * { grid-column: 1; margin-top: 0; }
    .post-list-entry--illustrated .post-list-content > p { grid-column: 1 / -1; }
    .post-list-entry--illustrated > img { grid-column: 2; grid-row: 1 / span 3; }
  }
</style>
