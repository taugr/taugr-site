---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props { post: CollectionEntry<'research'>; heading?: 'h2' | 'h3'; variant?: 'home' | 'index'; }
const { post, heading = 'h2', variant = 'index' } = Astro.props;
const href = `/research/${post.id}/`;
const Heading = heading;
const date = post.data.date.toISOString().slice(0, 10);
const displayDate = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{post && (
  <article class:list={['research-entry', { 'research-entry--index': variant === 'index' }]}>
    <div class="research-entry__content">
      {variant === 'home' && <p class="research-entry__meta">Updated <time datetime={date}>{displayDate}</time></p>}
      <Heading><a href={href}>{post.data.title}</a></Heading>
      {variant === 'index' && <p class="research-entry__meta">Updated <time datetime={date}>{displayDate}</time></p>}
      <p class="research-entry__description">{post.data.description}</p>
      <a class="research-entry__link" href={href}>Read the investigation<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </div>
    {post.data.image && <a href={href} class="research-entry__image" tabindex="-1" aria-hidden="true">
      <Image src={post.data.image} alt="" width={320} height={214} widths={[96, 160, 192, 320]} sizes="(min-width: 640px) 160px, 96px" format="webp" loading="lazy" />
    </a>}
  </article>
)}

<style>
  .research-entry { display: grid; grid-template-columns: minmax(0, 1fr) 192px; gap: 2rem; align-items: start; margin-top: 2rem; }
  .research-entry__meta { display: flex; gap: 0.4rem; flex-wrap: wrap; color: var(--color-text-tertiary); font-size: 0.76rem; margin-bottom: 0.75rem; }
  h2, h3 { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.7rem, 4vw, 2.2rem); font-weight: 400; line-height: 1.18; letter-spacing: -0.025em; text-wrap: balance; }
  h2 a, h3 a { color: var(--color-text); text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--color-link); }
  .research-entry__description { max-width: 65ch; margin-top: 0.8rem; color: var(--color-text-secondary); font-size: 0.94rem; line-height: 1.7; }
  .research-entry__link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; color: var(--color-link); font-size: 0.82rem; font-weight: 600; text-decoration: none; }
  .research-entry__link:hover { text-decoration: underline; }
  .research-entry__image { display: block; margin-top: 0.1rem; border: 1px solid var(--color-border-light); border-radius: 3px; overflow: hidden; }
  .research-entry__image img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .research-entry--index { grid-template-columns: minmax(0, 1fr) 160px; gap: 1rem; margin-top: 0; }
  .research-entry--index h2, .research-entry--index h3 { font-family: var(--font-sans); font-size: 1.08rem; font-weight: 600; line-height: 1.375; letter-spacing: normal; text-wrap: initial; }
  .research-entry--index .research-entry__meta { margin: 0.25rem 0 0; font-size: 0.82rem; }
  .research-entry--index .research-entry__description { margin-top: 0.375rem; line-height: 1.625; }
  @media (max-width: 639px) {
    .research-entry { grid-template-columns: minmax(0, 1fr) 96px; gap: 0.75rem 1rem; }
    .research-entry__content { display: contents; }
    h2, h3 { font-size: 1.35rem; }
    .research-entry__image { grid-column: 2; grid-row: 1 / span 2; }
    .research-entry__description, .research-entry__link { grid-column: 1 / -1; margin-top: 0; }
    .research-entry__meta { margin-bottom: 0; }
    .research-entry--index { grid-template-columns: minmax(0, 1fr) 96px; gap: 0.5rem 1rem; }
    .research-entry--index .research-entry__meta, .research-entry--index .research-entry__description { margin-top: 0; }
  }
</style>
