---
import { getMessages, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const messages = getMessages(locale);
---

<button
  id="theme-toggle"
  class="theme-toggle"
  aria-label={messages.theme.toggle}
  data-light-label={messages.theme.light}
  data-dark-label={messages.theme.dark}
>
  <i id="theme-icon" class="ph ph-sun" aria-hidden="true"></i>
  <span id="theme-label">{messages.theme.light}</span>
</button>

<script is:inline>
  function getThemePreference() {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return 'dark';
  }

  function setTheme(theme) {
    const root = document.documentElement;
    if (theme === 'dark') {
      root.classList.add('dark');
    } else {
      root.classList.remove('dark');
    }
    localStorage.setItem('theme', theme);
    const label = document.getElementById('theme-label');
    const toggle = document.getElementById('theme-toggle');
    const lightLabel = toggle?.dataset.lightLabel || 'light';
    const darkLabel = toggle?.dataset.darkLabel || 'dark';
    if (label) label.textContent = theme === 'dark' ? lightLabel : darkLabel;
    const icon = document.getElementById('theme-icon');
    if (icon) icon.className = theme === 'dark' ? 'ph ph-sun' : 'ph ph-moon';
  }

  // Set initial theme immediately to avoid flash
  setTheme(getThemePreference());

  // Toggle on click
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    setTheme(next);
    window.posthog?.capture('theme_toggled', { theme: next });
  });
</script>
