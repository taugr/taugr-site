---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import neukBike from '../assets/projects/neuk-bike.png';
import scranbook from '../assets/projects/scranbook.png';
import jevThumbnail from '../assets/essays/jev-moderation/jev-moderation-hero-390.webp';
import { projectStories } from '../data/project-stories';
import { essayPath, essaySlug, getLocalizedPosts } from '../data/essays';
import { localizeProject, localizedPath, LOCALES, type Locale } from '../i18n';

const { locale = 'en' as Locale } = Astro.props;
const posts = await getLocalizedPosts(locale);
const projects = await getCollection('projects');
const investigations = await getCollection('research', ({ data }) => !data.draft);
const essay = posts.find(post => essaySlug(post) === 'gradient-descent-can-do-math-better-than-you');
const jev = investigations.find(post => post.id === 'evaluating-jev-for-content-moderation');
const selectedProjects = ['neuk-bike', 'scranbook', 'aisdk-dt'].map(id => projects.find(project => project.id === id)).filter(Boolean);
const projectScreenshots = { 'neuk-bike': neukBike, scranbook };
const items = [
  ...(essay ? [{ title: essay.data.title, description: essay.data.description, date: essay.data.date, type: 'Essay', index: localizedPath(locale, 'essays'), href: essayPath(essay), updated: false, image: essay.data.image, imageAlt: essay.data.imageAlt ?? essay.data.title, logo: false }] : []),
  ...(jev ? [{ title: jev.data.title, description: jev.data.description, date: jev.data.date, type: 'Research', index: '/research/', href: `/research/${jev.id}/`, updated: true, image: jevThumbnail, imageAlt: jev.data.imageAlt ?? jev.data.title, logo: false }] : []),
  ...selectedProjects.map(project => {
    const screenshot = projectScreenshots[project.id as keyof typeof projectScreenshots];
    const copy = localizeProject(project, locale);
    return { title: project.data.name, description: copy.description, date: project.data.date, type: 'Project', index: localizedPath(locale, 'projects'), href: project.data.url ?? project.data.github, updated: false, image: screenshot ?? project.data.image, imageAlt: screenshot ? projectStories[project.id]?.en.alt ?? project.data.screenshotAlt ?? project.data.name : copy.imageAlt ?? project.data.name, logo: !screenshot };
  }),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<section id="recent-work" class="home-section" aria-labelledby="recent-work-title">
  <div class="section-heading">
    <h2 id="recent-work-title">{{ en: 'Recent work', es: 'Trabajo reciente', hy: 'Վերջին աշխատանքները' }[locale]}</h2>
    <span aria-hidden="true"></span>
  </div>
  <div class="curated-work">
    {items.map(item => (
      <article class:list={['curated-work__item', { 'curated-work__item--illustrated': item.image }]} data-work-type={item.type}>
        <div class="curated-work__meta">
          <a href={item.index}>{item.type}</a>
          <span aria-hidden="true">·</span>
          {item.updated && <span>Updated</span>}
          <time datetime={item.date.toISOString().slice(0, 10)}>{item.date.toLocaleDateString(locale === 'en' ? 'en-GB' : LOCALES[locale].tag, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
        </div>
        <h3><a href={item.href}>{item.title}</a></h3>
        <p>{item.description}</p>
        {item.image && (
          <div class:list={['curated-work__image', { 'curated-work__image--logo': item.logo }]}>
            {typeof item.image === 'string' ? (
              <img src={item.image} alt={item.imageAlt} width="390" height="260" loading="lazy" decoding="async" />
            ) : (
              <Image src={item.image} alt={item.imageAlt} width={320} height={214} widths={[96, 160, 192, 320]} sizes="(min-width: 640px) 160px, 96px" format={item.logo ? undefined : 'webp'} loading="lazy" />
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .curated-work { margin-top: 1.25rem; }
  .curated-work__item { padding: 1.15rem 0; border-top: 1px solid var(--color-border-light); }
  .curated-work__item:first-child { border-top: 0; padding-top: 0; }
  .curated-work__item:last-child { padding-bottom: 0; }
  .curated-work__item--illustrated { display: grid; grid-template-columns: minmax(0, 1fr) 160px; column-gap: 1.5rem; }
  .curated-work__item--illustrated > :not(.curated-work__image) { grid-column: 1; }
  .curated-work__image { grid-column: 2; grid-row: 1 / span 3; align-self: start; overflow: hidden; aspect-ratio: 3 / 2; border: 1px solid var(--color-border-light); border-radius: 3px; }
  .curated-work__image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .curated-work__image--logo img { object-fit: contain; padding: 0.7rem; }
  .curated-work__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--color-text-tertiary); font-size: 0.76rem; margin-bottom: 0.4rem; }
  .curated-work__meta a { color: var(--color-link); text-decoration: none; }
  h3 { font-family: var(--font-sans); font-size: 1.08rem; font-weight: 600; line-height: 1.375; }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a:hover, .curated-work__meta a:hover { color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; }
  p { max-width: 68ch; margin-top: 0.375rem; color: var(--color-text-secondary); font-size: 0.94rem; line-height: 1.625; }
  @media (max-width: 639px) {
    .curated-work__item--illustrated { grid-template-columns: minmax(0, 1fr) 96px; column-gap: 1rem; row-gap: 0.4rem; }
    .curated-work__item--illustrated .curated-work__meta { margin-bottom: 0; }
    .curated-work__item.curated-work__item--illustrated > p { grid-column: 1 / -1; margin-top: 0; }
    .curated-work__image { grid-row: 1 / span 2; }
    .curated-work__image--logo img { padding: 0.4rem; }
  }
</style>
