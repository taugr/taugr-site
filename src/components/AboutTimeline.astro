---
interface TimelineItem {
  title: string;
  organization: string;
  date: string;
  location: string;
  note: string;
  logo: string;
  url: string;
  links?: { href: string; label: string }[];
  link?: { href: string; label: string };
}
interface Props {
  items: TimelineItem[];
}
const { items } = Astro.props;
---

<ol class="career-timeline" role="list">
  {items.map((item, index) => (
    <li class:list={['career-entry', { 'career-entry--current': index === 0 }]}>
      <p class="career-date">{item.date}</p>
      <article class="career-detail">
        <div class="career-heading">
          <div class="career-logo">
            <img src={item.logo} alt="" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <div>
            <h2>{item.title}</h2>
            <a class="career-organization" href={item.url} target="_blank" rel="noopener">{item.organization}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </div>
        {item.location && <p class="career-location">{item.location}</p>}
        <p class="career-note">{item.note}</p>
        {(item.links ?? (item.link ? [item.link] : [])).map(link => (
          <a class="career-document" href={link.href} target="_blank" rel="noopener">
            <i class="ph ph-file-text" aria-hidden="true"></i><span>{link.label}</span>
          </a>
        ))}
      </article>
    </li>
  ))}
</ol>

<style>
  .career-timeline { margin: 3.5rem 0 0; padding: 0; list-style: none; }
  .career-entry { display: grid; grid-template-columns: 10rem minmax(0, 1fr); }
  .career-date { margin: 0; padding: 1.55rem 1.5rem 0 0; color: var(--color-text-secondary); font-size: .78rem; font-weight: 500; font-variant-numeric: tabular-nums; }
  .career-detail { position: relative; min-width: 0; padding: 1.35rem 0 2.1rem 1.75rem; border-left: 1px solid var(--color-border); }
  .career-detail::before { content: ''; position: absolute; left: -4px; top: 1.9rem; width: 7px; height: 7px; border-radius: 50%; background: var(--color-border); box-shadow: 0 0 0 5px var(--color-bg); }
  .career-entry--current .career-detail { background: var(--color-project-hover); border-radius: 0 .6rem .6rem 0; padding-right: 1.25rem; border-left-color: var(--color-link); margin-bottom: .75rem; }
  .career-entry--current .career-detail::before { background: var(--color-link); }
  .career-entry--current .career-date { color: var(--color-link); font-weight: 700; }
  .career-entry:last-child .career-detail { padding-bottom: .75rem; }
  .career-heading { display: flex; align-items: flex-start; gap: .9rem; }
  .career-heading > div:last-child { min-width: 0; }
  .career-logo { display: flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; flex-shrink: 0; padding: .35rem; border: 1px solid var(--color-border-light); border-radius: .4rem; background: white; }
  .career-logo img { width: 100%; height: 100%; object-fit: contain; }
  h2 { margin: 0; font-size: 1.06rem; font-weight: 600; line-height: 1.4; letter-spacing: -.02em; }
  .career-organization { color: var(--color-link); font-size: .85rem; line-height: 1.5; text-decoration: none; }
  .career-organization i { display: inline-block; margin-left: .3rem; font-size: .75rem; }
  .career-organization:hover { text-decoration: underline; text-underline-offset: 3px; }
  .career-location { margin: .8rem 0 0; color: var(--color-text-secondary); font-size: .78rem; }
  .career-note { margin: .6rem 0 0; color: var(--color-text-secondary); font-size: .9rem; line-height: 1.7; }
  .career-document { display: flex; align-items: flex-start; gap: .5rem; margin-top: .85rem; color: var(--color-link); font-size: .8rem; line-height: 1.6; text-decoration: underline; text-underline-offset: 3px; }
  .career-document i { flex-shrink: 0; margin-top: .2rem; font-size: 1rem; }
  @media (max-width: 640px) {
    .career-timeline { margin-top: 2.5rem; padding-left: .25rem; }
    .career-entry { grid-template-columns: minmax(0, 1fr); border-left: 1px solid var(--color-border); padding-left: 1.1rem; }
    .career-date { position: relative; padding: 1.15rem 0 .65rem; font-size: .75rem; }
    .career-date::before { content: ''; position: absolute; left: calc(-1.1rem - 4px); top: 1.7rem; width: 7px; height: 7px; border-radius: 50%; background: var(--color-border); box-shadow: 0 0 0 4px var(--color-bg); }
    .career-detail { padding: 0 0 1.5rem; border: 0; }
    .career-detail::before { display: none; }
    .career-entry--current { border-left-color: var(--color-link); }
    .career-entry--current .career-date::before { background: var(--color-link); }
    .career-entry--current .career-detail { padding: 1rem; border-radius: .5rem; }
    .career-heading { gap: .7rem; }
    .career-logo { width: 2.5rem; height: 2.5rem; }
    h2 { font-size: 1rem; }
  }
</style>
